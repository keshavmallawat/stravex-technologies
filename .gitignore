# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal
/qa.db
/qa.db-journal
/prod.db
/prod.db-journal
/db-backups/

# user-uploaded media (lives on the server disk, not in git)
/public/uploads/*
!/public/uploads/.gitkeep

# Firestore migration reports contain PII (names, emails, phone numbers) — local audit trail only
/migration-reports/

# any locally-copied Firebase service account keys
*firebase-adminsdk*.json
*serviceAccount*.json
