# Database Connection
# Required: A valid Prisma connection string
DATABASE_URL="file:./prod.db" # Example for SQLite. For production, use PostgreSQL/Turso URL.

# NextAuth Configuration
# Run `npx auth secret` to generate a secure secret.
AUTH_SECRET="<generate_secure_random_string>"

# NextAuth Host Trust (Mandatory in Production if not deployed on Vercel)
# Set to your production domain to bypass UntrustedHost errors.
AUTH_URL="https://www.yourdomain.com"
AUTH_TRUST_HOST="true"

# Google OAuth Credentials
# Obtain these from the Google Cloud Console (APIs & Services > Credentials)
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="<your_google_oauth_client_id>"
AUTH_GOOGLE_SECRET="<your_google_oauth_client_secret>"

# Admin Access Configuration
# Comma-separated list of Google account emails allowed to access the /admin dashboard.
# IMPORTANT: After modifying this list, you MUST run `npx prisma db seed` to apply changes.
ADMIN_EMAILS="your.email@example.com,another.admin@example.com"

# Cloudinary Integration (Media Library)
# Required for uploading and serving images.
CLOUDINARY_CLOUD_NAME="<your_cloudinary_cloud_name>"
CLOUDINARY_API_KEY="<your_cloudinary_api_key>"
CLOUDINARY_API_SECRET="<your_cloudinary_api_secret>"

# Legacy FIRESTORE migration settings (Optional, can be omitted for new setups)
# FIRESTORE_PROJECT_ID=""
# FIRESTORE_CLIENT_EMAIL=""
# FIRESTORE_PRIVATE_KEY=""
